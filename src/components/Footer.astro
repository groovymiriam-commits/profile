---
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-inner">

      <nav class="footer-socials" aria-label="Social media">
      {siteConfig.socialLinks.map((item) => (
        <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
          <img src={item.icon} alt="" aria-hidden="true" />
        </a>
      ))}
    </nav>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/#services">Services</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div>
      <a class="footer-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
   

  

    <div class="footer-meta">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p>
       <nav class="footer-legal" aria-label="Legal information">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/imprint">Imprint</a>
      <button type="button" class="footer-cookie-settings" data-cookie-settings>Cookie settings</button>
    </nav>
      
    </div>
  </div>
</footer>

<script>
  import { openConsentBanner } from '../scripts/consent';

  document.querySelectorAll('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', openConsentBanner);
  });
</script>
