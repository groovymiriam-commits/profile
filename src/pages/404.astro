---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout title="404 - Page Not Found" description="The page you're looking for couldn't be found.">
  <section class="section-404 container">
    <div class="content-404">
      <h1 class="title-404">404</h1>
      <h2 class="heading-404">Page not found</h2>
      <p class="description-404">
        It looks like this page wandered off. Let me help you find what you're looking for.
      </p>
      <div class="actions-404">
        <a class="button" href="/">Back home</a>
        <a class="button button-secondary" href="/blog/">Read articles</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @use '../styles/variables' as *;

  .section-404 {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: $spacing * 2 0;
  }

  .content-404 {
    max-width: 600px;
  }

  .title-404 {
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 700;
    line-height: 0.8;
    margin-bottom: 0.5rem;
    color: var(--primary);
    font-family: var(--font-title);
  }

  .heading-404 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin-bottom: 1.5rem;
    color: var(--primary);
  }

  .description-404 {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    line-height: 1.6;
    color: var(--text);
  }

  .actions-404 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .button-secondary {
    background: var(--light);
    color: var(--primary);
    border-color: var(--primary);
  }

  .button-secondary:hover {
    background: var(--border);
  }

  @media (max-width: 40rem) {
    .section-404 {
      min-height: 60vh;
      padding: $spacing 0;
    }

    .title-404 {
      font-size: 4rem;
    }

    .heading-404 {
      font-size: 1.75rem;
    }

    .actions-404 {
      flex-direction: column;
      gap: 0.75rem;
    }

    .button,
    .button-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
