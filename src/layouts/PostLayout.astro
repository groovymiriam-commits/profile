---
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    category: string;
    publishedAt: string;
    date: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <article class="post container">
    <header class="post-header">
      <a class="post-back" href="/blog/">← Back to all posts</a>
      <p class="eyebrow">{frontmatter.category}</p>
      <h1>{frontmatter.title}</h1>
      <time datetime={frontmatter.date}>{frontmatter.publishedAt}</time>
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-block: clamp(3rem, 8vw, 6rem);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.3) 100%);
  }

  .post-header,
  .post-content {
    width: min(100%, 48rem);
    margin-inline: auto;
  }

  .post-back {
    display: inline-block;
    margin-bottom: 2.5rem;
    padding: 0.5rem 0;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .post-back:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
  }

  .post-header p {
    margin: 0 0 1rem;
  }

  .post-header h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.4rem, 7vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.15;
    color: var(--primary);
  }

  .post-header time {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-content :global(h2) {
    margin: 2.5rem 0 1rem;
    padding-top: 0.5rem;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--primary);

  }

  .post-content :global(h3) {
    margin: 1.8rem 0 0.8rem;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    letter-spacing: -0.02em;
    color: var(--primary);
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.85;
    color: var(--text);
    font-size: 1.05rem;
  }

  .post-content :global(strong) {
    color: var(--primary);
    font-weight: 700;
  }

  .post-content :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.8;
    color: var(--text);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.8rem;
  }

  .post-content :global(li:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 0 1rem 1.5rem;
    border-left: 4px solid var(--secondary);
    background: rgba(var(--secondary-rgb, 243, 197, 158), 0.08);
    color: var(--primary);
    font-family: var(--font-title);
    font-size: 1.15rem;
    line-height: 1.7;
    font-style: italic;
  }

  .post-content :global(code) {
    padding: 0.2rem 0.5rem;
    background: rgba(var(--primary-rgb, 45, 41, 38), 0.08);
    border-radius: 0.3rem;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    color: var(--primary);
  }

  .post-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: var(--background);

    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .post-content :global(pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .post-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .post-content :global(a:hover) {
    opacity: 0.7;
  }

  @media (max-width: 48rem) {
    .post {
      padding-block: clamp(2rem, 5vw, 3rem);
    }

    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .post-header h1 {
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .post-content :global(h2) {
      font-size: clamp(1.2rem, 3vw, 1.6rem);
    }

    .post-content :global(blockquote) {
      padding: 0.75rem 0 0.75rem 1rem;
      font-size: 1rem;
    }
  }
</style>
